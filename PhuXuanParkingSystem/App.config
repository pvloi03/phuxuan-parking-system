<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <appSettings>
        <!-- ================= HỆ THỐNG LOGGING (SERILOG) ================= -->
        <!-- Mức độ ghi log: Warning (chỉ ghi lỗi/cảnh báo), Information (ghi chi tiết), Debug (kỹ thuật dò lỗi) -->
        <add key="LogLevel" value="Warning" />
        <add key="Log_Path" value="Logs/app-.log" />
        <add key="Log_RetainedDays" value="30" />
        <add key="Log_FileSizeLimitMB" value="50" />

        <!-- Thư mục lưu ảnh chụp -->
        <add key="CaptureSavePath" value="Captures" />

        <!-- ================= CƠ SỞ DỮ LIỆU MONGODB ================= -->
        <add key="MongoDb_ConnectionString" value="mongodb://localhost:27017" />
        <add key="MongoDb_DatabaseName" value="PhuXuanParkingSystemDb" />
    </appSettings>
</configuration>
