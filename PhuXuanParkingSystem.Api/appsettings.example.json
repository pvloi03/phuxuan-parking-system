{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:80",
  "ConnectionStrings": {
    "MongoDb": "mongodb://127.0.0.1:27017"
  },
  "DatabaseName": "PhuXuanParkingSystemDb",
  "JwtSettings": {
    "SecretKey": "YOUR_JWT_SECRET_KEY_HERE_MINIMUM_32_CHARACTERS_LONG!",
    "Issuer": "PhuXuanParkingSystem.Api",
    "Audience": "PhuXuanParkingSystem.Web",
    "ExpiryHours": 12
  },
  "CapturesSettings": {
    "FolderPath": "",
    "RetentionDays": 365,
    "CleanupHour": 2,
    "EnableAutoCleanup": true
  }
}
